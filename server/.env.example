# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# --- Database (PostgreSQL) ---
# Free-tier option: create a project at https://supabase.com, then use its
# "Connection string" (Session pooler, port 5432 or 6543) here.
# Local option: run your own Postgres and point this at it instead.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# --- Frontend / crypto / links ---
FRONTEND_URL="http://localhost:5174"
# Where THIS backend is publicly reachable — embedded as the image URL, the open-tracking pixel,
# and the click-redirect link in every campaign email. Leave blank for local dev (falls back to
# GOOGLE_REDIRECT_URI's origin, then to localhost); a real recipient's "localhost" is their own
# device, not this server, so set this to your deployed API's real URL before sending to anyone
# but yourself on this machine — see DEPLOYMENT.md.
PUBLIC_APP_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-a-64-char-hex-string-32-bytes"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
UNSUBSCRIBE_SECRET="replace-with-a-long-random-secret"
# Signs Viber "subscribe" deep-link invite tokens (Phase 7) — separate secret so rotating one
# never invalidates the other's links. Generate with the same command as above.
VIBER_INVITE_SECRET="replace-with-a-long-random-secret"

# --- Gmail API (Phase 6) ---
# Create these at https://console.cloud.google.com — see SETUP.md for the step-by-step
# (enable the Gmail API, configure the OAuth consent screen, create an OAuth 2.0 Client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/gmail/callback"

# --- WhatsApp / Viber (Phase 7) ---
# No env vars here by design — credentials are entered through the Integrations screen and stored
# encrypted per-Integration row in the database, exactly like Gmail's OAuth tokens. WhatsApp
# (Meta Cloud API) needs a Meta Business App + Business Verification; Viber needs a Public
# Account/BSP auth token. See SETUP.md.
