// Prisma schema — Multi-Channel Marketing Campaign Platform
// Target: PostgreSQL (Supabase free tier in dev/prod, self-hosted Postgres also supported)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- App-wide settings ----------

// A single row (id is always the literal "singleton") holding branding shown across the app's own
// UI — the sidebar, the login screen — not anything sent to customers. Public to read (the login
// page needs it before anyone is authenticated); Administrator-only to write.
model AppSettings {
  id          String   @id @default("singleton")
  companyName String?
  logoUrl     String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

// ---------- Auth / RBAC ----------

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ADMINISTRATOR, MARKETING_MANAGER, MARKETING_STAFF, SALES_MANAGER, SALES_STAFF, VIEWER
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "contacts:write", "campaigns:send"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdContacts       Contact[]        @relation("ContactCreatedBy")
  createdSegments       Segment[]        @relation("SegmentCreatedBy")
  createdTemplates      Template[]       @relation("TemplateCreatedBy")
  createdCampaigns      Campaign[]       @relation("CampaignCreatedBy")
  connectedIntegrations Integration[]    @relation("IntegrationConnectedBy")
  automationRules       AutomationRule[] @relation("AutomationCreatedBy")
  auditLogs             AuditLog[]

  @@map("users")
}

// ---------- Contacts / CRM ----------

enum ConsentChannel {
  EMAIL
  WHATSAPP
  VIBER
}

model Contact {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  company           String?
  email             String?
  mobileNumber      String?
  whatsappNumber    String?
  viberNumber       String?
  viberUserId       String?   @unique // captured only via the Viber webhook once the contact messages the Public Account — never user-entered
  viberSubscribedAt DateTime?
  customerType      String? // e.g. New Vehicle Lead, Previous Customer, Service Customer
  productInterest   String?
  location          String?
  leadSource        String?
  leadStatus        String? // Hot, Warm, Cold, etc.
  dateAdded         DateTime  @default(now())
  lastContactedAt   DateTime?
  notes             String?

  createdById String?
  createdBy   User?  @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  tags                  ContactTag[]
  consents              Consent[]
  suppressions          SuppressionList[]
  campaignRecipients    CampaignRecipient[]
  automationEnrollments AutomationEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([leadStatus])
  @@index([customerType])
  @@map("contacts")
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String?
  contacts  ContactTag[]
  campaigns CampaignTag[]

  createdAt DateTime @default(now())

  @@map("tags")
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

// ---------- Consent & Compliance ----------

model Consent {
  id            String         @id @default(cuid())
  contactId     String
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       ConsentChannel
  optIn         Boolean
  consentDate   DateTime       @default(now())
  consentSource String? // e.g. "Web form", "In-store", "CSV import"
  optOutDate    DateTime?
  createdAt     DateTime       @default(now())

  @@index([contactId, channel])
  @@map("consents")
}

model SuppressionList {
  id        String         @id @default(cuid())
  contactId String
  contact   Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel   ConsentChannel
  reason    String?
  addedAt   DateTime       @default(now())

  @@unique([contactId, channel])
  @@map("suppression_list")
}

// ---------- Segmentation ----------

model Segment {
  id          String  @id @default(cuid())
  name        String
  description String?
  rulesJson   Json // serialized rule tree, e.g. { and: [{ field, op, value }, { or: [...] }] }

  createdById String?
  createdBy   User?  @relation("SegmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("segments")
}

// ---------- Templates ----------

enum Channel {
  EMAIL
  WHATSAPP
  VIBER
}

// Where the image sits relative to the message body — email rendering only, since WhatsApp
// (Meta-approved templates) and Viber (plain text) don't currently embed the image at all.
enum ImagePosition {
  TOP
  BOTTOM
}

model Template {
  id            String        @id @default(cuid())
  name          String
  category      String // New Vehicle Promotion, Service Promotion, etc.
  channel       Channel
  subject       String? // email only
  body          String
  imageUrl      String?
  imagePosition ImagePosition @default(TOP)
  ctaLabel      String?
  ctaUrl        String?
  variables     String[] // e.g. ["first_name", "last_name", "company", "product_interest"]

  createdById String?
  createdBy   User?  @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

// ---------- Campaigns ----------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
  FAILED
}

model Campaign {
  id                       String         @id @default(cuid())
  name                     String
  type                     String? // e.g. Promotion, Event Invitation, Follow-Up
  channel                  Channel
  subject                  String?
  message                  String
  imageUrl                 String?
  imagePosition            ImagePosition  @default(TOP)
  videoUrl                 String?
  ctaLabel                 String?
  ctaUrl                   String?
  whatsappTemplateName     String? // name of the Meta-approved template; required to send on WHATSAPP
  whatsappTemplateLanguage String?        @default("en") // Meta template language code, e.g. "en", "en_US"
  status                   CampaignStatus @default(DRAFT)
  scheduledAt              DateTime?
  sentAt                   DateTime?
  // Orthogonal to status — a campaign in any status can be archived (hidden from the default
  // list) and unarchived, with nothing about it changed or lost. Distinct from Cancelled, which is
  // a real lifecycle state; archiving is purely a "get this out of my way" view filter.
  isArchived               Boolean        @default(false)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id])

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  senderIntegrationId String?
  senderIntegration   Integration? @relation(fields: [senderIntegrationId], references: [id])

  createdById String?
  createdBy   User?  @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  tags       CampaignTag[]
  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("campaigns")
}

model CampaignTag {
  campaignId String
  tagId      String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
  @@map("campaign_tags")
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPENED
  CLICKED
  UNSUBSCRIBED
  SUPPRESSED
}

model CampaignRecipient {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status       RecipientStatus @default(PENDING)
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  errorMessage String?

  messages CampaignMessage[]

  createdAt DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([status])
  @@map("campaign_recipients")
}

model CampaignMessage {
  id                  String            @id @default(cuid())
  campaignRecipientId String
  campaignRecipient   CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)
  channel             Channel
  providerMessageId   String?
  rawStatus           String?
  errorMessage        String?
  sentAt              DateTime          @default(now())

  @@map("campaign_messages")
}

// ---------- Integrations ----------

enum IntegrationType {
  GMAIL
  WHATSAPP
  VIBER
}

enum IntegrationStatus {
  NOT_CONFIGURED
  PENDING_VERIFICATION
  CONNECTED
  ERROR
  DISABLED
}

model Integration {
  id     String            @id @default(cuid())
  type   IntegrationType
  name   String
  status IntegrationStatus @default(NOT_CONFIGURED)
  config Json? // encrypted at the application layer before persisting

  connectedById String?
  connectedBy   User?   @relation("IntegrationConnectedBy", fields: [connectedById], references: [id])

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integrations")
}

// ---------- Automation ----------

enum AutomationTriggerType {
  NEW_CONTACT
  LEAD_STATUS_CHANGED
  MANUAL_ONLY
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AutomationStepStatus {
  SENT
  FAILED
  SKIPPED
}

model AutomationRule {
  id           String                @id @default(cuid())
  name         String
  triggerType  AutomationTriggerType
  triggerValue String? // e.g. the lead status ("Hot") for LEAD_STATUS_CHANGED; unused otherwise
  stepsJson    Json // [{ dayOffset, channel, templateId, whatsappTemplateName?, whatsappTemplateLanguage? }, ...]
  isActive     Boolean               @default(false)

  createdById String?
  createdBy   User?  @relation("AutomationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  enrollments AutomationEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automation_rules")
}

// One row per contact ever enrolled in a rule — never re-created for the same
// (automationRuleId, contactId) pair, so a contact can't be double-enrolled by the same trigger
// firing twice (e.g. two consecutive lead-status updates to the same target value).
model AutomationEnrollment {
  id               String           @id @default(cuid())
  automationRuleId String
  automationRule   AutomationRule   @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status           EnrollmentStatus @default(ACTIVE)
  currentStepIndex Int              @default(0)
  nextStepDueAt    DateTime?
  enrolledAt       DateTime         @default(now())
  completedAt      DateTime?
  cancelledAt      DateTime?

  steps AutomationStepLog[]

  @@unique([automationRuleId, contactId])
  @@index([status, nextStepDueAt])
  @@map("automation_enrollments")
}

// The automation-specific equivalent of CampaignMessage — a real, per-attempt log entry, never
// inferred after the fact. SKIPPED (consent/address failed the re-check at send time) is
// distinguished from FAILED (a real provider send was attempted and rejected) — see
// automation.service.ts for why they're handled differently (skip-and-advance vs retry-next-run).
model AutomationStepLog {
  id                String               @id @default(cuid())
  enrollmentId      String
  enrollment        AutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepIndex         Int
  channel           Channel
  status            AutomationStepStatus
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime             @default(now())

  @@map("automation_step_logs")
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "CAMPAIGN_SENT", "CONTACT_DELETED"
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
